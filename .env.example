# Copy to .env and fill in your values.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Stacks chain config
VITE_STACKS_CONTRACT_NAME="cardforge-nft"

# Network-specific contract addresses. The UI switch reads these so you can
# jump between testnet and mainnet without editing env files.
# Set the address after deploying to each network.
VITE_STACKS_CONTRACT_ADDRESS_TESTNET=""
VITE_STACKS_CONTRACT_ADDRESS_MAINNET=""

# Legacy single-network override (optional; takes precedence over the per-network keys).
# VITE_STACKS_CONTRACT_ADDRESS="ST..."

# Treasury wallet that receives mint fees. Defaults to the testnet address below
# when a mainnet treasury is not configured.
VITE_STACKS_TREASURY_ADDRESS_TESTNET=""
VITE_STACKS_TREASURY_ADDRESS_MAINNET=""

# Legacy single-network treasury override (optional).
# VITE_STACKS_TREASURY_ADDRESS="ST..."
